<Application x:Class="Kit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

    <FontFamily x:Key="Kit.UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Kit.MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Type -->
    <Style x:Key="Kit.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Kit.UiFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Kit.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Kit.UiFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Kit.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Kit.UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Kit.MutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Kit.UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Kit.MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Kit.MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Containers -->
    <Style x:Key="Kit.CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Kit.CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kit.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Kit.RowStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Kit.RowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kit.OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Kit.PanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Kit.PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kit.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Kit.ChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Kit.AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kit.OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="Kit.PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Kit.PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.OnAccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Kit.UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Kit.OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Kit.SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Kit.CardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kit.OutlineBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Kit.UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Kit.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Kit.PillButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Kit.PillBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.AccentInkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Kit.UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Kit.OutlineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Kit.GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.MutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Kit.UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Kit.HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Kit.TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Kit.OrbButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                        <Ellipse Width="20" Height="20" Fill="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Kit.AccentInkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Library rail -->
    <Style x:Key="Kit.RailItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Kit.UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="9,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}"
                                       FontSize="9"
                                       VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Kit.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Kit.AccentSoftBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Kit.AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource Kit.AccentInkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Kit.CategoryToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Kit.MutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Kit.UiFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="4,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Chevron"
                                       Text="▸"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Text" Value="▾" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fields -->
    <Style x:Key="Kit.FieldStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Kit.FieldBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Kit.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kit.OutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Kit.MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CaretBrush" Value="{DynamicResource Kit.AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Kit.AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

            <BooleanToVisibilityConverter x:Key="Kit.BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
